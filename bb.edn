;; babashka bundles nREPL and JLine, so unlike deps.edn there are no deps here.
{:min-bb-version "1.13.225"
 :paths ["src"]
 :bbin/bin {neorepl {:main-opts ["-m" "neorepl.main"]}}
 :tasks
 {test {:doc "Run the tests on babashka. Pass namespaces to run only those."
        :extra-paths ["test"]
        :requires ([neorepl.test-runner :as runner])
        :task (apply runner/-main *command-line-args*)}

  test:jvm {:doc "Run the tests on the JVM. Pass :1.10, :1.11 or :1.12 to pick a Clojure version."
            :requires ([clojure.string :as str])
            :task (clojure (str "-M:test" (str/join *command-line-args*)))}

  test:integration {:doc "Run the integration tests, against real servers, on babashka. They need the Clojure CLI."
                    :extra-paths ["test" "integration"]
                    :requires ([neorepl.test-runner :as runner])
                    :task (apply runner/-main "--dir" "integration" *command-line-args*)}

  test:integration:jvm {:doc "Run the integration tests on the JVM."
                        :task (clojure "-M:test:integration")}}}
